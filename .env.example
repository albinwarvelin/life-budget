# Runtime mode: use development for Vite, production for the integrated build.
APP_ENV=development

# Local SQLite stores. Relative paths are resolved from backend/.
DATABASE_URL=sqlite:///./life_budget.db
PREDICTION_DATABASE_URL=sqlite:///./life_budget_predictions.db

# Development frontend origin and local upload/OCR settings.
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
TESSERACT_COMMAND=tesseract
TESSERACT_LANGUAGES=eng+swe+nor

# Usually left unset: Vite proxies API requests in development and the
# production launcher uses same-origin requests.
VITE_API_BASE_URL=
